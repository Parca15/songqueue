# Copia a .env y completa los secretos. Genera SECRET_KEY con:
#   openssl rand -hex 32

# ── Base de Datos ──
DATABASE_URL=mysql+aiomysql://songqueue:TU_DB_PASSWORD@localhost:3306/songqueue

# ── Seguridad (obligatorio, sin defaults) ──
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── YouTube (opcional: sin clave usa yt-dlp como respaldo) ──
YOUTUBE_API_KEY=

# ── CORS: orígenes extra coma-separados (vacío = solo mismo origen) ──
CORS_ORIGINS=

# ── URL pública para los QR (ej. https://musica.tudominio.com) ──
SERVER_BASE_URL=

# ── Super admin (se crea solo si no existe ninguno) ──
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=cambia-esta-clave

# ── App ──
APP_NAME=SongQueue
DEBUG=false
HOST=0.0.0.0
PORT=8000
